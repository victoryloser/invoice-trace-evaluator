{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:invoice-trace-evaluator:case-assessment:1.0",
  "title": "AI开票离线轨迹评测单Case提交格式",
  "description": "提交文件为JSON Lines，每行必须符合本Schema。此URN仅为Schema标识，不是服务接口。",
  "type": "object",
  "required": ["case_id", "run_assessments", "version_comparison"],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "run_assessments": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["run_id", "agent_task_success", "business_invoice_created", "quality_score", "business_result_assessment", "process_assessment", "penalty_items", "root_causes", "downstream_impact", "improvement_suggestions", "evidence_event_ids", "explanation"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "agent_task_success": {"type": "boolean"},
          "business_invoice_created": {"type": "boolean", "description": "由离线输入摘要和回调记录推导的出票判断；不是独立查询外部开票服务或账本的结果。"},
          "business_invoice_evidence": {"type": "object", "description": "可选的出票来源说明：离线记录、字段路径、冲突状态与外部核验边界；外部核验未执行时必须保留未知。"},
          "quality_score": {"type": "number", "minimum": 0, "maximum": 100},
          "business_result_assessment": {"type": "string", "minLength": 1},
          "process_assessment": {"type": "string", "minLength": 1},
          "penalty_items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["dimension", "points_deducted", "evidence_event_ids", "explanation"],
              "properties": {
                "dimension": {"type": "string", "enum": ["BUSINESS_RESULT", "PROCESS", "TOOL_CALL", "RISK_CONTROL"]},
                "points_deducted": {"type": "number", "minimum": 0, "maximum": 100},
                "evidence_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "explanation": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "root_causes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["label", "first_fault_event_id", "evidence_event_ids", "explanation"],
              "properties": {
                "label": {
                  "type": "string",
                  "enum": [
                    "INTENT_CLASSIFICATION", "ENTITY_RESOLUTION", "FIELD_FABRICATION",
                    "AMOUNT_BASIS", "AMOUNT_CALCULATION", "PRODUCT_MATCH", "TOOL_ARGUMENT_ERROR", "MULTI_ITEM_OMISSION",
                    "CONTEXT_UPDATE", "DUPLICATE_CONTROL", "CONFIRMATION_BYPASS",
                    "TOOL_ERROR_HANDLING", "CALLBACK_MISINTERPRETATION",
                    "INSUFFICIENT_EVIDENCE"
                  ]
                },
                "first_fault_event_id": {"type": ["string", "null"]},
                "evidence_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "explanation": {"type": "string", "minLength": 1}
              },
              "additionalProperties": true
            }
          },
          "downstream_impact": {"type": "string"},
          "improvement_suggestions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "evidence_event_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "explanation": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "version_comparison": {
      "type": "object",
      "required": ["direction", "release_recommendation", "reason"],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["baseline_better", "candidate_better", "equal", "insufficient_evidence"]
        },
        "release_recommendation": {
          "type": "string",
          "enum": ["release", "gray", "defer", "investigate"]
        },
        "reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
